# Copie para .env e preencha apenas valores reais no ambiente local.
# Nunca versione secrets reais.

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/youtube/callback
FRONTEND_BASE_URL=http://localhost:5173

YOUTUBE_AUTO_PUBLISH=false
YOUTUBE_PRIVACY_STATUS=public

PUBLICATION_SETTINGS_FILE=/storage/publication_settings.json
MAX_UPLOADS_PER_DAY=5
PUBLISH_SCHEDULE=09:00,12:00,18:00
PUBLISH_TIMEZONE=America/Sao_Paulo
MANUAL_UPLOAD_COUNTS_TOWARD_DAILY_LIMIT=true

PUBLISHER_MAX_ATTEMPTS=5
PUBLISHER_RETRY_DELAYS=5,15,30,60
PUBLISHER_UPLOAD_TIMEOUT=60
PUBLISHER_PROCESSING_TIMEOUT=180
PUBLISHER_POLL_INTERVAL=60
YOUTUBE_PROCESSING_POLL_INTERVAL=60
RECOVERY_INTERVAL=300
WORKER_STALE_TIMEOUT=300
WORKER_RUN_ONCE=false

CLEANUP_AFTER_PUBLISHED=true
CLEANUP_DELAY_HOURS=0
TIKTOK_ENABLED=false

PIPELINE_JOB_TIMEOUT=7200
OLLAMA_URL=http://host.docker.internal:11434/api/generate
CLIP_FINDER_MAX_DISCOVERY_ATTEMPTS=1

STYLE_AI_ENABLED=true
STYLE_AI_TIMEOUT_SECONDS=60
STYLE_AI_MAX_TEXT_CHARS=2500
STYLE_AI_MAX_ATTEMPTS=2

VITE_API_BASE_URL=http://localhost:8000
VITE_POLL_INTERVAL=8000
VITE_STALE_AFTER_MS=120000
